{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm preview:*)",
      "Bash(pnpm dev:*)",
      "Bash(git check-ignore:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm up:*)",
      "Bash(pnpm approve-builds:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
