---
import { NAMESPACE_TONES } from "@/data/site";

interface Props {
  text: string;
  /**
   * Class per code token, keyed by the token's exact text. Defaults to the namespace
   * tones, so the previous repository and this one are told apart by color wherever
   * either is named, without every caller having to remember to pass them.
   */
  tones?: Readonly<Record<string, string>>;
}

// Text in src/data/site.ts is written in the small part of Markdown that /llms.txt needs:
// backticks for code and `[label](href)` for a link. One string then serves the page and
// that file, so neither can carry a sentence the other does not.
const { text, tones = NAMESPACE_TONES } = Astro.props;

type Part =
  | { kind: "text"; value: string }
  | { kind: "code"; value: string }
  | { kind: "link"; value: string; href: string };

const TOKEN = /`([^`]+)`|\[([^\]]+)\]\(([^)]+)\)/g;

const parts: Part[] = [];
let at = 0;
for (const match of text.matchAll(TOKEN)) {
  const start = match.index ?? 0;
  if (start > at) parts.push({ kind: "text", value: text.slice(at, start) });
  if (match[1] !== undefined) {
    parts.push({ kind: "code", value: match[1] });
  } else {
    parts.push({ kind: "link", value: match[2] as string, href: match[3] as string });
  }
  at = start + match[0].length;
}
if (at < text.length) parts.push({ kind: "text", value: text.slice(at) });
---

{parts.map((part) =>
  part.kind === "code" ? (
    <code class={tones?.[part.value]}>{part.value}</code>
  ) : part.kind === "link" ? (
    <a href={part.href}>
      {/* A link label carries code spans of its own, so a repository name can be both
          the link and set in the code face. */}
      {part.value
        .split("`")
        .map((piece, i) => (i % 2 ? <code class={tones?.[piece]}>{piece}</code> : piece))}
    </a>
  ) : (
    part.value
  ),
)}
