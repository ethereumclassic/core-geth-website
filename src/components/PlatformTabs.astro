---
/**
 * One tab per platform, with no script: the tabs are radio inputs and labels, and CSS shows the
 * checked one's panel. Every panel stays in the HTML, so a browser without `:has()`, a reader
 * with CSS off and a crawler all get all of them rather than none (maintainer decision,
 * 2026-10-07).
 *
 * A page can carry several sets, so `prefix` keeps their radio groups and ids apart. Each set
 * chooses on its own: one choice driving every set would take a script, or a radio input far
 * from the labels that use it, which a keyboard reader could not reach from where they are.
 *
 * A panel that needs more than its steps takes it from a named slot: `before-<id>` above the
 * steps, `after-<id>` under the guide link.
 *
 * A set can sit inside another set's panel, as the build-from-source tabs sit inside each Source
 * panel: `nested` drops its headings a level. Every rule below reaches only its own set's bar and
 * panels, so a choice in the inner set never shows a panel of the outer one.
 *
 * A step that runs differently for some readers carries its ways as tabs of its own: one per
 * distribution, processor or way the node runs, each with its own blocks (maintainer, 2026-11-12). They
 * are radio inputs and labels too, a group per step that chooses on its own, beside the labels that use
 * it. The group is a `div` with `role="radiogroup"`, not a `fieldset`, so a script that reads a panel up
 * to its set's closing `</fieldset>` still reads every block in it. Without `:has()`, every way shows,
 * each under its own name.
 */
import ArrowText from "@/components/ArrowText.astro";
import InlineCode from "@/components/InlineCode.astro";
import Recording from "@/components/Recording.astro";
import StepBlocks from "@/components/StepBlocks.astro";

/** A note to read first, a block to run, and a note on what it leaves: one part of a step. */
export interface StepBlock {
  before?: string;
  code?: string;
  after?: string;
}

/** One way to take a step, as a tab of its own. Its blocks run in order. */
export interface StepVariant extends StepBlock {
  label: string;
  more?: readonly StepBlock[];
  recording?: StepRecording;
}

/**
 * What a reader does in order: `before` for what a block needs them to read first, a block to run,
 * `after` for what it leaves them to do, `more` blocks after it, then `variants` for a step that runs
 * differently for some readers, `then` for what every way leaves, and a recording of the step being run.
 */
export interface PanelStep extends StepBlock {
  title: string;
  more?: readonly StepBlock[];
  variants?: readonly StepVariant[];
  /** What the variant tabs choose between, for a screen reader, such as "Choose your distribution". */
  choose?: string;
  then?: string;
  recording?: StepRecording;
}

export interface PlatformPanel {
  /** One of the five the styles below can show: a sixth needs its own rule there. */
  id: "linux" | "macos" | "windows" | "containers" | "source";
  label: string;
  /** The panel's heading, when it needs more words than its tab's label. */
  heading?: string;
  steps: readonly PanelStep[];
  /** Left out where a set inside the panel links each platform's guide itself. */
  guide?: { label: string; href: string };
}

/**
 * A recording of a step being run, shown under it with the browser's own controls: it plays
 * only when a reader starts it, and plays with JavaScript off. The step's block carries every
 * command the recording shows, as text.
 */
export interface StepRecording {
  webm: string;
  mp4: string;
  poster: string;
  width: number;
  height: number;
  /** What was recorded, set above the caption. Backticks mark code. */
  label: string;
  /** What the recording shows. Backticks mark code. */
  caption: string;
}

interface Props {
  legend: string;
  panels: readonly PlatformPanel[];
  prefix?: string;
  nested?: boolean;
}

const { legend, panels, prefix = "", nested = false } = Astro.props;
const Heading = nested ? "h4" : "h3";
const Step = nested ? "h5" : "h4";

// The styles below show a step's ways by position, up to six. A seventh would never show.
for (const panel of panels) {
  for (const step of panel.steps) {
    if (step.variants && (step.variants.length < 2 || step.variants.length > 6)) {
      throw new Error(
        `"${step.title}" offers ${step.variants.length} ways: between two and six fit`,
      );
    }
    if (step.variants && !step.choose) {
      throw new Error(
        `"${step.title}" offers ways with no \`choose\` to name them for a screen reader`,
      );
    }
  }
}
---

<fieldset class:list={["tabs", { "tabs--nested": nested }]}>
  <legend class="visually-hidden">{legend}</legend>
  <div class="tabs__bar">
    {panels.map((panel, index) => (
      <Fragment>
        <input
          class="tabs__input visually-hidden"
          type="radio"
          name={`${prefix}platform`}
          id={`${prefix}tab-${panel.id}`}
          data-platform={panel.id}
          checked={index === 0}
        />
        <label class="tabs__label" for={`${prefix}tab-${panel.id}`}>
          {panel.label}
        </label>
      </Fragment>
    ))}
  </div>

  {panels.map((panel) => (
    <div class="panel" id={`${prefix}panel-${panel.id}`} data-platform={panel.id}>
      <Heading class="panel__heading">{panel.heading ?? panel.label}</Heading>
      <slot name={`before-${panel.id}`} />
      {panel.steps.map((step, s) => (
        <Fragment>
          <Step class="panel__step">{step.title}</Step>
          <StepBlocks blocks={[step, ...(step.more ?? [])]} />
          {step.variants && (
            <div class="choice">
              <div class="choice__bar" role="radiogroup" aria-label={step.choose}>
                {step.variants.map((variant, v) => (
                  <Fragment>
                    <input
                      class="choice__input visually-hidden"
                      type="radio"
                      name={`${prefix}${panel.id}-step-${s}`}
                      id={`${prefix}${panel.id}-step-${s}-${v}`}
                      data-index={v}
                      checked={v === 0}
                    />
                    <label class="choice__label" for={`${prefix}${panel.id}-step-${s}-${v}`}>
                      {variant.label}
                    </label>
                  </Fragment>
                ))}
              </div>
              {step.variants.map((variant, v) => (
                <div class="choice__panel" data-index={v}>
                  <p class="choice__name">{variant.label}</p>
                  <StepBlocks blocks={[variant, ...(variant.more ?? [])]} />
                  {variant.recording && <Recording recording={variant.recording} />}
                </div>
              ))}
            </div>
          )}
          {step.then && (
            <p class="panel__note">
              <InlineCode text={step.then} />
            </p>
          )}
          {step.recording && <Recording recording={step.recording} />}
        </Fragment>
      ))}
      {panel.guide && (
        <a class="more" href={panel.guide.href}>
          <ArrowText text={panel.guide.label} />
        </a>
      )}
      <slot name={`after-${panel.id}`} />
    </div>
  ))}
</fieldset>

<style>
  /* The tab strip. The fieldset carries no frame of its own; the strip and the panel below it
     share one. */
  .tabs {
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .tabs__bar {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--hairline);
    border-bottom: 0;
    background: var(--surface);
  }

  .tabs__label {
    flex: 1 1 auto;
    padding: 0.8rem 1.25rem;
    border-right: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 650;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
  }

  .tabs__label:last-of-type {
    border-right: 0;
  }

  .tabs__label:hover {
    color: var(--ink);
    background: var(--ground);
  }

  .panel {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding: 2rem clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .panel + .panel {
    border-top: 0;
  }

  .panel__heading {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* Global, because what a page passes through a panel's slots sets these two as well. */
  :global(.panel__step) {
    margin: 0.4rem 0 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  :global(.panel__note) {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* A long path has no space to break at, and would otherwise widen the panel, and the page
     with it, on a narrow screen. */
  :global(.panel__note code) {
    overflow-wrap: anywhere;
  }

  /* A set inside a panel is the second choice a reader makes, so its strip is quieter. */
  .tabs--nested .tabs__label {
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
  }

  .tabs--nested .panel__heading {
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
  }

  /* With `:has()` the checked radio shows its panel. Without it, or with CSS off
     entirely, every panel stays visible: the page loses the tabs, never the content.
     The child combinators keep each set to its own radios and panels, so a set inside
     a panel neither shows nor hides anything in the set around it. */
  @supports selector(:has(*)) {
    .panel {
      display: none;
    }

    .tabs:has(> .tabs__bar > .tabs__input[data-platform="linux"]:checked)
      > .panel[data-platform="linux"],
    .tabs:has(> .tabs__bar > .tabs__input[data-platform="macos"]:checked)
      > .panel[data-platform="macos"],
    .tabs:has(> .tabs__bar > .tabs__input[data-platform="windows"]:checked)
      > .panel[data-platform="windows"],
    .tabs:has(> .tabs__bar > .tabs__input[data-platform="containers"]:checked)
      > .panel[data-platform="containers"],
    .tabs:has(> .tabs__bar > .tabs__input[data-platform="source"]:checked)
      > .panel[data-platform="source"] {
      display: grid;
    }

    .tabs__input:checked + .tabs__label {
      color: var(--bar-strong);
      background: var(--accent);
    }

    .tabs__input:focus-visible + .tabs__label {
      outline: 2px solid var(--accent);
      outline-offset: -4px;
    }
  }

  @media (max-width: 36rem) {
    .tabs__label {
      flex: 1 1 40%;
      padding: 0.7rem 0.75rem;
      border-bottom: 1px solid var(--hairline);
    }
  }

  /* A step's ways: a strip quieter than a set's, over the blocks of the one chosen. Without
     `:has()` the strip stays hidden and every way shows under its own name, so the page loses the
     tabs, never a command. */
  .choice {
    display: grid;
    gap: 0.9rem;
    justify-self: stretch;
    width: 100%;
    min-width: 0;
  }

  .choice__bar {
    display: none;
  }

  .choice__panel {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    min-width: 0;
  }

  .choice__name {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
  }

  @supports selector(:has(*)) {
    .choice__bar {
      display: flex;
      flex-wrap: wrap;
      justify-self: start;
      max-width: 100%;
      border: 1px solid var(--hairline);
      background: var(--surface);
    }

    .choice__label {
      padding: 0.45rem 0.9rem;
      border-right: 1px solid var(--hairline);
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 650;
      text-align: center;
      white-space: nowrap;
      cursor: pointer;
    }

    .choice__label:last-of-type {
      border-right: 0;
    }

    .choice__label:hover {
      color: var(--ink);
      background: var(--ground);
    }

    .choice__input:checked + .choice__label {
      color: var(--bar-strong);
      background: var(--accent);
    }

    .choice__input:focus-visible + .choice__label {
      outline: 2px solid var(--accent);
      outline-offset: -4px;
    }

    .choice__name,
    .choice__panel {
      display: none;
    }

    .choice:has(> .choice__bar > .choice__input[data-index="0"]:checked)
      > .choice__panel[data-index="0"],
    .choice:has(> .choice__bar > .choice__input[data-index="1"]:checked)
      > .choice__panel[data-index="1"],
    .choice:has(> .choice__bar > .choice__input[data-index="2"]:checked)
      > .choice__panel[data-index="2"],
    .choice:has(> .choice__bar > .choice__input[data-index="3"]:checked)
      > .choice__panel[data-index="3"],
    .choice:has(> .choice__bar > .choice__input[data-index="4"]:checked)
      > .choice__panel[data-index="4"],
    .choice:has(> .choice__bar > .choice__input[data-index="5"]:checked)
      > .choice__panel[data-index="5"] {
      display: grid;
    }

    @media (max-width: 36rem) {
      .choice__bar {
        justify-self: stretch;
        border-bottom: 0;
      }

      .choice__label {
        flex: 1 1 auto;
        border-bottom: 1px solid var(--hairline);
      }
    }
  }
</style>
