---
import Icon from "@/components/Icon.astro";
import type { RepositoryFacts } from "@/data/repository";
import { REPO } from "@/data/site";

interface Props {
  facts: RepositoryFacts;
}

// Links, with no count, version or date (maintainer, 2026-11-01): a number read at build time
// is stale the moment someone stars or forks the repository or a release ships, and nothing
// schedules a build. Each link stays right without one. The release link is GitHub's
// latest-release address, and the other three go where a reader can act, in the order GitHub
// sets them.
const { facts } = Astro.props;
const [owner, project] = REPO.slug.split("/");
---

<article class="repo" aria-labelledby="repo-name">
  <div class="repo__head">
    <Icon name="github" size={40} />
    <h3 id="repo-name" class="repo__name">
      <a href={REPO.url}>
        <span class="repo__owner">{owner}/</span>
        <wbr />
        <span class="repo__project">{project}</span>
      </a>
    </h3>
  </div>
  <p class="repo__description">{facts.description}</p>
  <div class="repo__releases">
    <a class="button button--primary" href={REPO.latestUrl}>
      <Icon name="tag" />
      Latest release
    </a>
    <a class="button" href={REPO.releasesUrl}>
      All releases
    </a>
  </div>
  <ul class="repo__actions" role="list">
    <li>
      <a class="button" href={REPO.url}>
        <Icon name="eye" />
        Watch<span class="visually-hidden"> this repository on GitHub</span>
      </a>
    </li>
    <li>
      <a class="button" href={REPO.forkUrl}>
        <Icon name="fork" />
        Fork<span class="visually-hidden"> this repository on GitHub</span>
      </a>
    </li>
    <li>
      <a class="button" href={REPO.url}>
        <Icon name="star" />
        Star<span class="visually-hidden"> this repository on GitHub</span>
      </a>
    </li>
  </ul>
</article>

<style>
  .repo {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  /* On the narrowest screens the name drops below the mark instead of overflowing. */
  .repo__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    color: var(--ink);
  }

  .repo__head :global(svg) {
    flex: none;
  }

  /* The name as GitHub sets it, owner light and repository heavy, in the
     documentation's code face. */
  .repo__name {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 4.4vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .repo__name a {
    color: var(--ink);
    text-decoration: none;
  }

  .repo__name a:hover .repo__project {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .repo__owner {
    color: var(--muted);
    font-weight: 400;
  }

  .repo__description {
    color: var(--text);
  }

  /* Two rows that fill the card and wrap on the narrowest screens rather than overflowing. */
  .repo__releases {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .repo__releases .button {
    flex: 1 1 auto;
    padding-inline: 0.75rem;
  }

  .repo__actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .repo__actions .button {
    width: 100%;
    padding-inline: 0.5rem;
  }
</style>
