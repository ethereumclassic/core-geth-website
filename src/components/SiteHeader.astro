---
import Icon from "@/components/Icon.astro";
import { BRAND_MENU, DOCS, GUIDE_PAGES, REPO, SITE_NAME } from "@/data/site";

// The same bar the documentation's header is: the mark and the name on the left, the three
// routes a reader needs and the repository on the right, by name alone. A count or a tag read
// at build time is stale the moment it changes (maintainer, 2026-11-01).
---

<header class="bar">
  <div class="container bar__inner">
    <div class="brand-menu">
      <a class="brand" href="/" aria-describedby="brand-menu-hint">
        <img src="/logo.svg" alt="" width="30" height="30" />
        <span class="brand__name">{SITE_NAME}</span>
      </a>
      <span id="brand-menu-hint" class="visually-hidden">
        The pages of this site follow this link
      </span>
      <ul class="brand-menu__list">
        {BRAND_MENU.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <nav class="bar__nav" aria-label="Site">
      <a class="bar__link" href="/downloads/">
        Downloads
      </a>
      <a class="bar__link" href={GUIDE_PAGES.index.href}>
        {GUIDE_PAGES.index.title}
      </a>
      <a class="bar__link" href={DOCS.home.href}>
        Documentation
      </a>
      <a class="source" href={REPO.url}>
        <Icon name="github" size={22} />
        <span class="source__name">{REPO.slug}</span>
        <span class="visually-hidden">{" on GitHub"}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .bar {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--bar-line);
    background: var(--bar);
    color: var(--bar-text);
  }

  .bar :focus-visible {
    outline-color: var(--bar-accent);
  }

  .bar__inner {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    padding-block: 0.5rem;
  }

  /* The brand opens the site's pages on hover and on focus, with no script: `:hover` and
     `:focus-within` on the wrapper, so it works from the keyboard and, with CSS off,
     degrades to the brand link followed by a plain list of the same pages. */
  .brand-menu {
    position: relative;
  }

  .brand-menu__list {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
  }

  .brand-menu__list a {
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: calc(var(--radius) / 2);
    color: var(--bar-text);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-menu__list a:hover,
  .brand-menu__list a:focus-visible {
    background: color-mix(in srgb, var(--bar-strong) 12%, transparent);
    color: var(--bar-strong);
  }

  .brand-menu__list {
    position: absolute;
    top: 100%;
    left: -0.4rem;
    z-index: 30;
    visibility: hidden;
    min-width: 12rem;
    border: 1px solid var(--bar-line);
    border-radius: var(--radius);
    background: var(--bar);
    opacity: 0;
  }

  .brand-menu:hover .brand-menu__list,
  .brand-menu:focus-within .brand-menu__list {
    visibility: visible;
    opacity: 1;
  }

  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    /* The name is one word: never broken at its hyphen on a narrow screen. */
    white-space: nowrap;
    color: var(--bar-strong);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .bar__nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  /* The name, the link and the mark need about 300px; a 320px phone has 288
     inside the gutters, so the gaps give way there. */
  /* Under 30rem the bar cannot hold the wordmark and its three routes at once, and the name
     set nowrap would run under them. The mark stays, the hero carries the wordmark a
     moment later, and the link still reads as the home page to assistive technology. */
  @media (max-width: 30rem) {
    .bar__inner {
      gap: 0.5rem;
    }

    .bar__nav {
      gap: 0.9rem;
    }

    .brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* At 22.5rem and under, the mark, three routes and the repository's icon need more than a
     320px screen leaves inside its gutters, so the gaps between the routes close further. */
  @media (max-width: 22.5rem) {
    .bar__nav {
      gap: 0.55rem;
    }
  }

  .bar__link {
    color: var(--bar-strong);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .bar__link:hover {
    color: var(--bar-accent);
  }

  .source {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--bar-strong);
    text-decoration: none;
  }

  .source:hover .source__name {
    color: var(--bar-accent);
  }

  /* Narrow screens keep the GitHub mark and read the name to assistive technology. */
  .source__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .source__name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }
</style>
