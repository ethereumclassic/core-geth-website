---
import Icon from "@/components/Icon.astro";
import { getRepository } from "@/data/repository";
import { DOCS, REPO, SITE_NAME } from "@/data/site";

// The same bar the documentation's header is: the mark and the name on the left,
// the repository on the right with its release, stars and forks. The facts come
// from the build, like the repository card's.
const facts = await getRepository();
---

<header class="bar">
  <div class="container bar__inner">
    <a class="brand" href="/">
      <img src="/logo.svg" alt="" width="30" height="30" />
      <span>{SITE_NAME}</span>
    </a>
    <nav class="bar__nav" aria-label="Site">
      <a class="bar__link" href={DOCS.home.href}>
        Documentation
      </a>
      <a class="source" href={REPO.url}>
        <Icon name="github" size={22} />
        <span class="source__text">
          <span class="source__name">{REPO.slug}</span>
          <span class="source__facts" aria-hidden="true">
            <span>
              <Icon name="tag" size={12} />
              {facts.release.tag}
            </span>
            <span>
              <Icon name="star" size={12} />
              {facts.stars}
            </span>
            <span>
              <Icon name="fork" size={12} />
              {facts.forks}
            </span>
          </span>
        </span>
        <span class="visually-hidden">
          {` on GitHub: latest release ${facts.release.tag}, ${facts.stars} stars, ${facts.forks} forks`}
        </span>
      </a>
    </nav>
  </div>
</header>

<style>
  .bar {
    border-bottom: 1px solid var(--bar-line);
    background: var(--bar);
    color: var(--bar-text);
  }

  .bar :focus-visible {
    outline-color: var(--bar-accent);
  }

  .bar__inner {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    color: var(--bar-strong);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .bar__nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  /* The name, the link and the mark need about 300px; a 320px phone has 288
     inside the gutters, so the gaps give way there. */
  @media (max-width: 22.5rem) {
    .bar__inner {
      gap: 0.5rem;
    }

    .bar__nav {
      gap: 0.75rem;
    }
  }

  .bar__link {
    color: var(--bar-strong);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .bar__link:hover {
    color: var(--bar-accent);
  }

  .source {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--bar-strong);
    text-decoration: none;
  }

  .source:hover .source__name {
    color: var(--bar-accent);
  }

  /* Narrow screens keep the GitHub mark and read the name to assistive technology. */
  .source__text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .source__text {
      position: static;
      display: grid;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      line-height: 1.3;
    }
  }

  .source__name {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .source__facts {
    display: flex;
    gap: 0.75rem;
    color: var(--bar-text);
    font-size: 0.75rem;
  }

  .source__facts > span {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
  }
</style>
