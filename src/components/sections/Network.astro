---
import LinkRow from "@/components/LinkRow.astro";
import InlineCode from "@/components/InlineCode.astro";
import SectionHead from "@/components/SectionHead.astro";
import { NETWORK_RUNNING } from "@/data/site";

// The exposure table. The one section where color carries meaning, so its heading
// carries no green emphasis of its own, and every row states its status in words as
// well as in color. The roles restate the table's semantics for the narrow layout,
// where the rows stack and some browsers otherwise drop them.
interface Props {
  /** The band's tone, so the page it sits in keeps alternating. */
  tone?: "grid" | "surface";
}

const { tone = "surface" } = Astro.props;
const { measured, source, evidence, goAdvisories, upgrade, total, unlisted, lede, rows } =
  NETWORK_RUNNING;
---

<section
  class:list={["band", tone === "surface" && "band--surface"]}
  aria-labelledby="network-title"
>
  <div class="container network">
    <div class="network__head">
      <SectionHead
        id="network-title"
        label="Ethereum Classic nodes"
        title="Most Ethereum Classic nodes are running an exposed release"
        size="medium"
      >
        <p class="lede">
          <InlineCode text={lede} />
        </p>
      </SectionHead>
      <a class="button button--primary network__upgrade" href={upgrade.href}>
        {upgrade.label}
      </a>
    </div>
    <slot />

    <table class="census" role="table">
      <caption>
        {"Core-Geth nodes by release on "}
        <time datetime={measured.iso}>{measured.text}</time>
        {`, ${total} in all. Source: `}
        <a href={source.href}>{source.label}</a>
        {`. The ${unlisted.nodes} nodes not listed above ran `}
        <InlineCode text={unlisted.what} />
        {"."}
        <LinkRow
          label="Where the figures in this table come from"
          links={[
            { label: "The evidence for each row", href: evidence, icon: "checklist" },
            { label: goAdvisories.label, href: goAdvisories.href, icon: "book" },
          ]}
        />
      </caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">
            Running
          </th>
          <th scope="col" role="columnheader" class="census__num">
            Nodes
          </th>
          <th scope="col" role="columnheader" class="census__num">
            Share
          </th>
          <th scope="col" role="columnheader">
            Carries
          </th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {rows.map((row) => (
          <>
            <tr role="row" class:list={["census__row", `census__row--${row.status}`]}>
              <th scope="row" role="rowheader" class="census__running" data-label="Running">
                <span class="census__release">
                  <InlineCode text={row.running} />
                </span>
                <span class="visually-hidden">, </span>
                <span class="status">{row.status}</span>
              </th>
              <td role="cell" class="census__num census__nodes" data-label="Nodes">
                {row.nodes}
              </td>
              <td role="cell" class="census__num census__share" data-label="Share">
                {row.share}
              </td>
              <td role="cell" class="census__state" data-label="Carries">
                <InlineCode text={row.summary} />
              </td>
            </tr>
            <tr
              role="row"
              class:list={["census__row", `census__row--${row.status}`, "census__detail-row"]}
            >
              <td role="cell" colspan="4" class="census__detail">
                <details class="census__more" open>
                  <summary>
                    {"What "}
                    <InlineCode text={row.running} />
                    {" carries"}
                  </summary>
                  <p>
                    <InlineCode text={row.detail} />
                  </p>
                  {row.status === "recommended" && (
                    <a class="button button--primary census__cta" href={upgrade.href}>
                      {upgrade.label}
                    </a>
                  )}
                </details>
              </td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .network {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* The heading and lede on the left, the upgrade on the right, level with the
     lede's last line. They stack on a narrow screen, the button under the lede. */
  /* The lede runs the band's width and the call sits under it. Set beside the button it
     broke at about 60% of the measure, which read as four short lines. */
  .network__head {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  @media (min-width: 56rem) {
    .network__head {
      gap: 1.75rem;
    }
  }

  .network__upgrade {
    justify-self: start;
  }

  /* Each row carries its state three ways: a bar at its left edge, a faint tint, and
     a pill that names it. Greyscale, a screenshot or a screen reader keeps the word. */
  .census__row--exposed {
    --state: var(--exposed);
    --state-tint: var(--exposed-tint);
  }

  .census__row--recommended {
    --state: var(--accent);
    --state-tint: var(--recommended-tint);
  }

  .census {
    width: 100%;
    border-top: 2px solid var(--ink);
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .census caption {
    padding-top: 1rem;
    caption-side: bottom;
    color: var(--muted);
    font-size: 0.95rem;
    text-align: left;
  }

  /* The row sits under the sentence rather than running on from it. */
  .census caption :global(.linkrow) {
    margin-top: 0.55rem;
  }

  .census thead th {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: left;
  }

  .census tbody th,
  .census tbody td {
    padding: 0.95rem 1rem;
    background: var(--state-tint);
    text-align: left;
    vertical-align: middle;
  }

  .census tbody th {
    border-left: 0.3rem solid var(--state);
  }

  /* A release is two rows, its tally and what it carries, so the rule sits under the
     pair rather than between them, and the state bar runs down both. */
  .census__detail {
    padding-top: 0;
    border-bottom: 1px solid var(--hairline);
    border-left: 0.3rem solid var(--state);
  }

  .census__more summary {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .census__more summary::-webkit-details-marker {
    display: none;
  }

  .census__more summary::after {
    width: 0.33rem;
    height: 0.33rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.1rem) rotate(45deg);
    content: "";
  }

  .census__more[open] summary::after {
    transform: translateY(0.06rem) rotate(-135deg);
  }

  .census__more summary:hover {
    color: var(--ink);
  }

  /* The same call as the one above the table, placed where an operator reaches the row
     that answers what to run. */
  .census__cta {
    margin-top: 0.9rem;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  .census__more p {
    margin: 0.5rem 0 0;
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* Written against the cells themselves so they outrank the rules above: Astro's
     scoping adds an attribute to every part of a selector, and the general cell rules
     would otherwise win. */
  .census thead th.census__num,
  .census tbody td.census__num {
    text-align: right;
    white-space: nowrap;
  }

  .census__running {
    color: var(--ink);
    font-weight: 600;
  }

  .census__release {
    margin-right: 0.6rem;
    font-size: 1.05rem;
  }

  .census__nodes {
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .census__share {
    color: var(--ink);
    font-weight: 600;
  }

  .census__state {
    color: var(--text);
  }

  /* The card's pill, in the row's state: its word, its color and a dot. */
  .status {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.1rem 0.6rem 0.1rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--state) 40%, var(--surface));
    border-radius: 999px;
    background: var(--surface);
    color: var(--state);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 650;
    line-height: 1.4;
    white-space: nowrap;
  }

  .status::before {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    content: "";
  }

  /* Narrow screens: each row becomes a card, its release and state on top, the
     counts beneath, then what it carries. The column names ride along as labels,
     drawn for the eye and hidden from screen readers, which have the headers. */
  @media (max-width: 40rem) {
    .census,
    .census tbody,
    .census tr,
    .census th,
    .census td {
      display: block;
    }

    .census thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* A column, so the caption can keep its place under the rows. */
    .census {
      display: flex;
      flex-direction: column;
      border-top: 0;
    }

    .census caption {
      display: block;
      order: 1;
    }

    .census tbody {
      display: grid;
      gap: 0.75rem;
    }

    .census tbody tr {
      display: grid;
      grid-template-areas:
        "running running"
        "nodes share"
        "state state";
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem 1rem;
      padding: 1rem 1.1rem;
      border-left: 0.3rem solid var(--state);
      border-radius: 0 var(--radius) var(--radius) 0;
      background: var(--state-tint);
    }

    .census tbody th,
    .census tbody td {
      padding: 0;
      border: 0;
      background: none;
      text-align: left;
    }

    .census tbody th {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      justify-content: space-between;
      grid-area: running;
    }

    .census tbody td.census__num {
      text-align: left;
    }

    .census__nodes {
      grid-area: nodes;
    }

    .census__share {
      grid-area: share;
    }

    .census__state {
      grid-area: state;
    }

    .census td::before {
      display: block;
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 600;
      content: attr(data-label) / "";
    }

    /* A release is one card here too: the detail row closes the grid gap above it and
       rounds the bottom, so the pair reads as a single block rather than two. */
    .census tbody tr.census__detail-row {
      display: block;
      margin-top: -0.75rem;
      padding-top: 0;
      border-top-right-radius: 0;
    }

    .census tbody tr:not(.census__detail-row) {
      border-bottom-right-radius: 0;
    }

    .census td.census__detail::before {
      content: none;
    }
  }
</style>
