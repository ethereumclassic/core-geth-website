---
import ArrowText from "@/components/ArrowText.astro";
import InlineCode from "@/components/InlineCode.astro";
import SectionHead from "@/components/SectionHead.astro";
import { STEWARDSHIP, SUPPORT, UPGRADE_REGISTRY } from "@/data/site";
---

<section class="band" aria-labelledby="support-title">
  <div class="container">
    <div class="support bracketed">
      <SectionHead
        id="support-title"
        label="Support Core-Geth"
        title={SUPPORT.statement}
        em="no long-term funding solution"
      />
      <div class="support__body">
        <p class="lede">{SUPPORT.body}</p>
      </div>
      <ol class="timeline" role="list">
        {STEWARDSHIP.map((item) => (
          <li class="timeline__point">
            <time class="timeline__date" datetime={item.date}>
              {item.date}
            </time>
            <h3 class="timeline__heading">{item.heading}</h3>
            <p class="timeline__span">{item.span}</p>
            <p class="timeline__body">
              <InlineCode text={item.body} />
            </p>
            <a class="more" href={item.link.href}>
              <ArrowText text={item.link.label} />
            </a>
          </li>
        ))}
      </ol>
      <p class="support__registry">
        Activation blocks from <a href={UPGRADE_REGISTRY.href}>{UPGRADE_REGISTRY.label}</a>, the
        network's upgrade registry.
      </p>
      <div class="support__close">
        <p class="support__ask">{SUPPORT.close}</p>
        <a class="button button--primary" href={SUPPORT.cta.href}>
          {SUPPORT.cta.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* The span of upgrades each one funded, set in the code face under the link so the
     four read as a continuous handover down the network's history. */
  .timeline__span {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .support__registry {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* The page closes the way the hero opens, inside the card's corner brackets:
     the statement on the left, and on a wide screen what follows from it on the
     right, level with its last line. */
  .support {
    display: grid;
    gap: 1.75rem;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
  }

  @media (min-width: 60rem) {
    .support {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: end;
    }
  }

  .support__body {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  /* The close carries the argument's last move and the only call in the band, so it sits
     under the funders rather than beside the statement. */
  .support__close {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-top: 2.25rem;
    border-top: 1px solid var(--grid);
  }

  .support__ask {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (min-width: 60rem) {
    .support__close {
      grid-column: 1 / -1;
    }
  }

  /* The timeline itself is in global.css, shared with the security records. Here it only
     has to span both columns of the band once the band has two. */
  @media (min-width: 60rem) {
    .timeline {
      grid-column: 1 / -1;
    }
  }

  .timeline__heading {
    margin: 0 0 0.5rem;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .timeline__body {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
