---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ArrowText from "@/components/ArrowText.astro";
import { SITE_URL } from "@/data/site";

// The layout for the apex security documents under /security/<slug>/: the audits and the
// release report, rendered here as the canonical, designed version of the content the
// documentation publishes. A markdown page sets `layout` to this file and carries its own
// title, description, label, em, crumb, date, iso, kind and sourceDoc in front matter.
//
// The page's only h1 is PageHero's; each source document's own H1 is stripped by
// .local/scratch/apex-transform.py so the body opens at h2. The TechArticle JSON-LD sits in
// the body, which is valid and keeps BaseLayout's head graph untouched.
const { frontmatter } = Astro.props;
const { title, description, label, em, crumb, date, iso, kind } = frontmatter;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const kindLabel = kind === "report" ? "Release report" : "Audit";

const techArticle = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${canonical}#techarticle`,
  headline: title,
  description,
  inLanguage: "en",
  datePublished: iso,
  mainEntityOfPage: canonical,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  about: { "@id": `${SITE_URL}/#software` },
  publisher: { "@type": "Organization", name: "Core-Geth" },
};
const techArticleText = JSON.stringify(techArticle).replaceAll("<", "\\u003c");
---

<BaseLayout title={title} description={description} crumb={crumb}>
  <PageHero label={label} title={title} em={em}>
    <p class="lede">{description}</p>
  </PageHero>

  <section class="band band--surface">
    <div class="container doc">
      <p class="doc__meta">
        <span class="doc__kind">{kindLabel}</span>
        <span aria-hidden="true">·</span>
        <time datetime={iso}>{date}</time>
      </p>
      <article class="prose">
        <slot />
      </article>
      <p class="doc__back">
        <a href="/security/">
          <ArrowText text="All Core-Geth audits and reports" />
        </a>
      </p>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={techArticleText}></script>
</BaseLayout>

<style>
  .doc {
    display: grid;
    gap: 1.5rem;
  }

  .doc__meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .doc__kind {
    color: var(--accent);
    font-weight: 600;
  }

  .doc__back {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .doc__back a {
    font-weight: 650;
    text-decoration: none;
  }

  .doc__back a:hover {
    text-decoration: underline;
  }

  /* The rendered document. Text runs a reading measure; tables, code and the collapsible
     advisory lists span the band so their columns stay legible. */
  .prose {
    display: grid;
    gap: 1.15rem;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .prose > :global(p),
  .prose > :global(ul),
  .prose > :global(ol),
  .prose > :global(blockquote),
  .prose > :global(h2),
  .prose > :global(h3),
  .prose > :global(h4) {
    max-width: 46rem;
  }

  .prose :global(h2) {
    margin: 1.9rem 0 0;
    padding-top: 1.4rem;
    border-top: 2px solid var(--ink);
    color: var(--ink);
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .prose :global(h3) {
    margin: 1.4rem 0 0;
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .prose :global(h4) {
    margin: 1.1rem 0 0;
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 700;
  }

  .prose :global(a) {
    color: var(--accent);
    font-weight: 550;
    text-underline-offset: 2px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.4rem;
  }

  .prose :global(li) {
    padding-left: 0.2rem;
  }

  /* Inline code keeps the ink color; a namespace span keeps its red or green tone, which
     the rehype pass in astro.config.mjs sets and global.css colors. */
  .prose :global(:not(pre) > code) {
    padding: 0.1rem 0.35rem;
    border-radius: calc(var(--radius) / 2.5);
    background: var(--ground);
    font-family: var(--font-mono);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  .prose :global(:not(pre) > code:not(.namespace--current, .namespace--previous)) {
    color: var(--ink);
  }

  .prose :global(pre) {
    margin: 0;
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* A wide table scrolls within the band rather than forcing the page wide. */
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  .prose :global(thead th) {
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(blockquote) {
    margin: 0;
    padding-left: 1rem;
    border-left: 0.25rem solid var(--accent);
    color: var(--text);
  }

  .prose :global(hr) {
    width: 100%;
    height: 1px;
    margin: 0.5rem 0;
    border: 0;
    background: var(--hairline);
  }

  /* The collapsible advisory lists. Closed by default unless the source marked it open. */
  .prose :global(details) {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--ground);
  }

  .prose :global(details > summary) {
    padding: 0.85rem 1.15rem;
    color: var(--ink);
    font-weight: 650;
    cursor: pointer;
  }

  .prose :global(details[open] > summary) {
    border-bottom: 1px solid var(--hairline);
  }

  .prose :global(details > *:not(summary)) {
    margin-inline: 1.15rem;
  }

  .prose :global(details > *:last-child) {
    margin-bottom: 1.15rem;
  }
</style>
