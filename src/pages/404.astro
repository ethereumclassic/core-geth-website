---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { DOCS } from "@/data/site";

// GitHub Pages serves this file for any path that does not exist, so it keeps the
// site's header and footer and offers the two places a visitor is looking for.
// Its canonical is /404.html, the one address where this content really lives.
---

<BaseLayout
  title="Page not found"
  description="There is no page at this address on coregeth.com. Go to the home page or to the Core-Geth documentation."
  robots="noindex, follow"
  path="/404.html"
>
  <PageHero label="Not found" title="Page not found.">
    <p class="lede">There is no page at this address on coregeth.com.</p>
    <div class="not-found__actions">
      <a class="button button--primary" href="/">
        Go to the home page
      </a>
      <a class="button" href="/downloads/">
        Downloads
      </a>
      <a class="button" href={DOCS.home.href}>
        Read the documentation
      </a>
    </div>
  </PageHero>
</BaseLayout>

<style>
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
</style>
