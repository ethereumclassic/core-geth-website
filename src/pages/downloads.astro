---
import ArrowText from "@/components/ArrowText.astro";
import CopyButtons from "@/components/CopyButtons.astro";
import InlineCode from "@/components/InlineCode.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PlatformTabs, { type PlatformPanel } from "@/components/PlatformTabs.astro";
import ReleaseFiles from "@/components/ReleaseFiles.astro";
import SectionHead from "@/components/SectionHead.astro";
import { getDownloads } from "@/data/release-assets";
import { formatAsOf, getRepository } from "@/data/repository";
import {
  DOCS,
  DISCOVERY_FLAG_ANCHOR,
  DOCS_URL,
  EXPOSED_LINE,
  MOVE_RECOMMENDATION,
  RECOMMENDED_LINE,
  REPO,
  UPGRADE_ANCHOR,
  UPGRADE_COST,
} from "@/data/site";

// Every file the latest release published, read from GitHub at build time rather than
// listed by hand, behind one tab per platform.
const downloads = await getDownloads();

// Every command that names a release names a real one, even when the API cannot be reached:
// the asset list comes from the release, and the tag falls back to the repository snapshot. A
// build that lost the API still publishes commands a reader can run; only the file table, which
// cannot be known without the API, degrades.
//
// Use `latest` where it is an option (maintainer, 2026-11-02). An image tag can say it, so the
// containers blocks do. A file name cannot, because every asset of a release carries the tag, so
// archive and image-file commands, and a source build's `--branch`, name the last release.
const facts = await getRepository();
const releaseTag = downloads?.tag ?? facts.release.tag;

// The notes below tell a reader to stop unless a command reports the recommended line, so the
// release this build read has to be on that line.
if (!releaseTag.startsWith(`${RECOMMENDED_LINE}.`)) {
  throw new Error(`the latest release, ${releaseTag}, is outside ${RECOMMENDED_LINE}`);
}

const assetBase = `https://github.com/${REPO.slug}/releases/download/${releaseTag}`;

const attestationMust = (workflow: string, action = "run the file") =>
  `\`gh attestation verify\` needs the GitHub CLI, signed in with \`gh auth login\`. It must print \`Verification succeeded\` and name \`.github/workflows/${workflow}\`. If it does not, do not ${action}.`;

const windowsCompare =
  "Compare those two lines yourself: the letters must match and the case need not, since `Get-FileHash` prints uppercase and the `.sha256` file holds lowercase followed by the file name.";

// One panel per platform the project publishes for, plus source. Every command is the one
// its linked guide gives, with that guide's version comment dropped, because this page
// names no version of its own. There is no iOS or Android tab: no release publishes a
// mobile artifact to put in one.
//
// No block carries a `$` or `>` prompt: a reader selects the whole block and pastes it
// into a shell, so a prompt would have to be stripped line by line first. Expected output
// goes on a comment line of its own, or in the note under the block.
//
// The macOS blocks carry no comments at all, and no block carries one after a command. Stock
// zsh, the macOS default, treats `#` in a paste as a command or an argument, so a comment line
// prints an error and a trailing comment makes `shasum -c` fail on the `#`. The Windows blocks
// can carry comments, which PowerShell reads as comments.
//
// A pasted block carries on past a failed line. So where a block checks what it downloaded, the
// lines after the check are chained to it, and the line that starts a node sits in a block of its
// own, which a failed check cannot reach. PowerShell's check is two lines a reader compares by eye,
// and a paste does not wait for the reader, so on Windows nothing follows those lines in their block.
const PANELS: readonly PlatformPanel[] = [
  {
    id: "linux",
    label: "Linux",
    steps: [
      {
        title: "Download the release, check it and install it",
        code: `curl -LO ${assetBase}/core-geth-linux-${releaseTag}.zip
curl -LO ${assetBase}/core-geth-linux-${releaseTag}.zip.sha256
sha256sum -c core-geth-linux-${releaseTag}.zip.sha256 &&
  unzip -o core-geth-linux-${releaseTag}.zip &&
  sudo install -m 0755 geth /usr/local/bin/geth &&
  geth version`,
        after:
          "`sha256sum -c` must print `OK`: if it prints `FAILED`, delete the file and download it again rather than running it. On an Arm board, put the name for your processor where the file name says `linux`: `arm64` if `uname -m` prints `aarch64` or `arm64`, `arm7` for `armv7l`, `arm6` for `armv6l`, and `arm5` for `armv5tel`.",
      },
      {
        title: "Start a node on Ethereum Classic",
        code: "geth --classic",
        after: "For the Mordor test network, run `geth --mordor` instead.",
      },
    ],
    guide: { label: "Linux users guide", href: `${DOCS_URL}getting-started/run/linux/` },
  },
  {
    id: "macos",
    label: "macOS",
    steps: [
      {
        title: "Download the release, check it and install it",
        code: `curl -LO ${assetBase}/core-geth-osx-arm64-${releaseTag}.zip
curl -LO ${assetBase}/core-geth-osx-arm64-${releaseTag}.zip.sha256
shasum -a 256 -c core-geth-osx-arm64-${releaseTag}.zip.sha256 &&
  unzip -o core-geth-osx-arm64-${releaseTag}.zip &&
  sudo install -m 0755 geth /usr/local/bin/geth &&
  geth version`,
        after: `\`shasum -a 256 -c\` must print \`OK\`: if it prints \`FAILED\`, delete the file and download it again rather than running it. On an Intel Mac, use \`core-geth-osx-${releaseTag}.zip\`. A browser download carries the quarantine attribute, which macOS blocks: \`xattr -d com.apple.quarantine geth\` clears it.`,
      },
      {
        title: "Start a node on Ethereum Classic",
        code: "geth --classic",
        after: "For the Mordor test network, run `geth --mordor` instead.",
      },
    ],
    guide: { label: "macOS users guide", href: `${DOCS_URL}getting-started/run/macos/` },
  },
  {
    id: "windows",
    label: "Windows",
    steps: [
      {
        title: "Download the release and check it",
        code: `# In PowerShell
Invoke-WebRequest "${assetBase}/core-geth-win64-${releaseTag}.zip" -OutFile "core-geth-win64-${releaseTag}.zip"
Invoke-WebRequest "${assetBase}/core-geth-win64-${releaseTag}.zip.sha256" -OutFile "core-geth-win64-${releaseTag}.zip.sha256"

# Compare these two lines
(Get-FileHash "core-geth-win64-${releaseTag}.zip" -Algorithm SHA256).Hash
Get-Content "core-geth-win64-${releaseTag}.zip.sha256"`,
        after: `${windowsCompare} If they differ, delete the file and download it again rather than running it.`,
      },
      {
        title: "If the two lines match, unpack the release",
        code: `Expand-Archive "core-geth-win64-${releaseTag}.zip" -DestinationPath C:\\core-geth -Force
C:\\core-geth\\geth.exe version`,
        after: `The last line must report a \`${RECOMMENDED_LINE}\` release.`,
      },
      {
        title: "Start a node on Ethereum Classic",
        code: `cd C:\\core-geth
.\\geth.exe --classic`,
        after: "For the Mordor test network, run `.\\geth.exe --mordor` instead.",
      },
    ],
    guide: { label: "Windows users guide", href: `${DOCS_URL}getting-started/run/windows/` },
  },
  {
    id: "containers",
    label: "Containers",
    steps: [
      {
        title: "Pull the published image and check where it came from",
        code: `docker pull ghcr.io/${REPO.slug}:latest
gh attestation verify oci://ghcr.io/${REPO.slug}:latest --repo ${REPO.slug}`,
        after: attestationMust("docker-publish.yml", "run the image"),
      },
      {
        title: "Start a node, keeping the chain in a named volume",
        code: `docker run --rm ghcr.io/${REPO.slug}:latest version
docker run -d --name core-geth-classic \\
    --restart unless-stopped --stop-timeout 300 \\
    -v core-geth-classic:/root \\
    -p 30303:30303 -p 30303:30303/udp \\
    ghcr.io/${REPO.slug}:latest --classic`,
        after:
          "The first line confirms that the image runs. The volume is mounted at `/root`, so the chain survives the container being replaced. For Mordor, run the same command with `core-geth-mordor` as the container and volume name and `--mordor` as the flag.",
      },
    ],
    guide: { label: "Docker users guide", href: `${DOCS_URL}getting-started/run/docker/` },
  },
  {
    id: "source",
    label: "Source",
    steps: [
      {
        title: "Build the latest release",
        code: `git clone --branch ${releaseTag} --single-branch https://github.com/${REPO.slug}.git core-geth-${releaseTag} &&
  cd core-geth-${releaseTag} &&
  make geth &&
  ./build/bin/geth version`,
        after:
          "A second run stops at the clone, because the folder already exists, rather than building an old copy.",
      },
      {
        title: "Build what is in development",
        code: `git clone https://github.com/${REPO.slug}.git &&
  cd core-geth &&
  make geth &&
  ./build/bin/geth version`,
        after:
          "`main` keeps moving, and it is not a release. An existing `core-geth` folder stops this block at the clone, so update or remove that folder first.",
      },
      {
        title: "Build on Windows",
        code: `git clone --branch ${releaseTag} --single-branch https://github.com/${REPO.slug}.git "core-geth-${releaseTag}"
cd "core-geth-${releaseTag}"
go run build/ci.go install ./cmd/geth
.\\build\\bin\\geth.exe version`,
        after: `Run these in PowerShell, one line at a time. For what is in development, leave out \`--branch ${releaseTag} --single-branch\` and the folder name, and run \`cd core-geth\`.`,
      },
    ],
    guide: { label: "Build from source", href: `${DOCS_URL}developers/build-from-source/` },
  },
];

const groupFor = (id: string) => downloads?.groups.find((group) => group.id === id);

const cleanStop = "Wait until the log prints `Blockchain stopped` and the process exits.";

const keepId =
  'Keep what this prints: "Confirm the move" compares the new ID and block number with it.';

const rotationRequired =
  "The next start writes a fresh key. If you start the node with `--nodekey` or `--nodekeyhex`, or set `GETH_NODEKEY` or `GETH_NODEKEYHEX`, take that out too: it overrides the file. If the rename prints an error, check the data directory: `geth/nodekey` must not be there when the node starts.";

const verifyPointer = "[Verify what you downloaded](#verify) also checks where the file came from.";

const keepBinary = `\`geth-${EXPOSED_LINE}\` is the old binary, kept so you can roll back.`;

const confirmNote = `If an attach line cannot connect, wait a minute and run it again. The first line must name a \`${RECOMMENDED_LINE}\` release. The enode ID must differ from the one you recorded. If it is the same, the node is still on the old key: stop it and redo the rename step. The peer count climbs within minutes. If it stays at zero, see [Why does the node have no peers?](${DOCS_URL}operate/troubleshooting/#why-does-the-node-have-no-peers) The block number resumes where the node stopped, then catches up. Compare it with a block explorer or another node you run. If it settles somewhere else, stop and investigate rather than resync.`;

// Peers a node lists by ID, in the file it reads at the start or on the console while it runs. The new
// ID exists only after the first start on the new key, so one step edits this node's own list while it
// is down, and another, after the start, gives the new ID to the nodes that list this one. Measured
// across a rotation, from `v1.12.17` up: a two-line file changes nothing but the list, and a console
// change lasts until that node restarts.
const staticPeersStep = (extra = "") => ({
  title: "If this node lists static peers, update the list",
  before:
    "They are under `[Node.P2P]` in the file you pass with `--config`. Edit it while the node is down:",
  code: `[Node.P2P]
StaticNodes = ["enode://<node ID>@<IP>:30303"]`,
  after: `A peer that has already moved has a new ID, so use that. Separate entries with commas. \`TrustedNodes\` takes the same entries. With no file yet, save these two lines and add \`--config\` and the file's path to the start command. The client ignores \`static-nodes.json\`, so move its entries here.${extra}`,
});

const otherNodesStep = (attach: string, ipc: string, extra = "") => ({
  title: "If other nodes list this node, give them the new ID",
  before: `They can no longer connect to this node, and neither side logs it at the default verbosity. On each one, on \`${EXPOSED_LINE}\` or \`${RECOMMENDED_LINE}\`, run these lines with the old ID you recorded, the new ID from the step above, and the address and port the entry already has.`,
  code: `${attach} --exec "admin.removePeer('enode://<old ID>@<IP>:30303')" ${ipc}
${attach} --exec "admin.addPeer('enode://<new ID>@<IP>:30303')" ${ipc}
${attach} --exec "admin.peers.map(function(p){return p.enode})" ${ipc}`,
  after: `The first two lines each print \`true\` and take effect with no restart. The third lists the new ID once the nodes connect. The change lasts only until that node restarts, so put the new ID in its config file too. Send the new ID to anyone else who lists this node. For an entry in \`TrustedNodes\`, use \`admin.removeTrustedPeer\` and \`admin.addTrustedPeer\`. They do not open a connection. [Static and trusted peers](${DOCS_URL}guides/bootnodes-and-discovery/#static-and-trusted-peers) explains the two lists.${extra}`,
});

// While the node is down, in the guide's order: MESS is in its "What changes" and the RPC check is
// its step 4. Neither has a command of its own, because both are flags the reader already sets. A
// file `dumpconfig` wrote on `v1.12` is in neither. From `v1.12.19` up it loads and silently keeps
// that release's discovery lists and bootnodes, so the note says what to delete. The note does not warn
// about the old `ECBP1100` and `ECBP1100Disable` keys, because that reads as a break the release does
// not have: `v1.13` reads `OverrideECBP1100`, `OverrideECBP1100Deactivate` and `ECBP1100NoDisable`.
// `v1.12.17` and `v1.12.18` refuse their own `"<nil>"` dump, every release from `v1.12.19` refuses a
// value in those two keys, and the `Fatal` line names the key.
const checkFlags = {
  title: "Check the flags you start the node with",
  after: `While the node is down, decide MESS, which makes a node resist deep chain reorganizations. An upgrade can change whether a node runs MESS, so set it yourself: \`--mess\` turns it on and \`--mess=false\` turns it off. [Which setting fits which operator](${DOCS.messSetting.href}) sets out the choice. An exchange setting its confirmation policy can use the [MESS confirmation calculator](${DOCS_URL}guides/mess-calculator/) to see what that policy asks of an attacker. Give every node you run the same setting. If you use a config file that \`dumpconfig\` wrote on \`${EXPOSED_LINE}\`, delete its \`BootstrapNodes\`, \`EthDiscoveryURLs\` and \`SnapDiscoveryURLs\` lines, or the node keeps that release's peer lists. Then go through the [RPC exposure checklist](${DOCS.migration.href}#re-check-rpc-exposure).`,
};

// For an operator who has not run the recommended line yet: one new node first, beside the nodes they
// run, then the move (maintainer, 2026-11-03). It is optional and best practice, and done when it has
// caught up and holds peers (maintainer, 2026-11-04). The install steps at the top of this page suit it,
// because it has no old key, and it gets a machine of its own, because those steps install over the
// `geth` on `PATH` and start on the default data directory. It peers and syncs, but no RPC clients or
// miners point at it, as the census lede on `/security/` says, because the migration guide asks for one
// MESS setting per fleet and a release's MESS default need not match the fleet's. It may start from a
// copy of a stopped `v1.12` node's data directory without its `geth/nodekey` (maintainer, 2026-11-04):
// a copy carries the key, and that key is the exposed one, which the move section's lede explains.
const trialNode = {
  title: `Optional: if you have not run ${RECOMMENDED_LINE} yet, sync one new node first`,
  after: `Best practice before you move a \`${EXPOSED_LINE}\` node: set up one new node on the \`${RECOMMENDED_LINE}\` line, on a machine of its own beside the nodes you run, with the [install steps](#install) at the top of this page, and point no RPC clients or miners at it. It can sync from the network, or start from a copy of a stopped \`${EXPOSED_LINE}\` node's data directory without its \`geth/nodekey\`. Once \`eth.syncing\` returns \`false\` and \`net.peerCount\` is above zero ([How to tell it is done](${DOCS_URL}getting-started/run-classic-node/#how-to-tell-it-is-done)), move each \`${EXPOSED_LINE}\` node with the steps below.`,
};

// Moving a node off the exposed line. Another page links this section rather than carrying a
// block of its own, because only this page's script gives a code block its copy button.
//
// One panel per platform, in the migration guide's order, except that the download comes first, so
// the node keeps running until the new release is in hand and checked. The blocks are separate on
// purpose: a pasted block carries on past a failed line, so the rename that rotates the key stands
// alone and the start has a block of its own, which a failed rename cannot reach. `&&` holds the
// install lines together for the same reason, and because a `sudo` line can swallow the lines still
// waiting in a paste. No block carries a comment, except in PowerShell, because stock zsh, the macOS
// default, treats `#` in a paste as a command or an argument.
//
// Every command is the one that platform's migration guide gives, apart from what keeps a paste safe
// and the rollback intact. `mv -n` keeps a second paste from overwriting the old key, and the install
// saves the old binary only once, so the block can run again after a mistake. The source panel clones
// the tag into its own folder, so an old clone cannot be rebuilt by mistake. The containers panel
// renames the key from a throwaway container and gives the new container the old one's volumes, which
// needs no `sudo` and no host path, and it keeps the old container to roll back to. "Confirm the move"
// reads the release from the running node, because `geth version` reads the binary on `PATH`, which
// need not be the binary a unit starts. Every console line that carries an enode wraps it in single
// quotes inside double quotes, the one form PowerShell 5.1 passes to a native program unchanged.
const MOVE_PANELS: readonly PlatformPanel[] = [
  {
    id: "linux",
    label: "Linux",
    steps: [
      trialNode,
      {
        title: "Download the release and check it",
        code: `curl -LO ${assetBase}/core-geth-linux-${releaseTag}.zip
curl -LO ${assetBase}/core-geth-linux-${releaseTag}.zip.sha256
sha256sum -c core-geth-linux-${releaseTag}.zip.sha256`,
        after: `The node can keep running for this step. \`sha256sum -c\` must print \`OK\`: if it prints \`FAILED\`, delete the file and download it again rather than running it. ${verifyPointer} On an Arm board, put the name for your processor where the file name says \`linux\`, here and in the install step: \`arm64\` if \`uname -m\` prints \`aarch64\` or \`arm64\`, \`arm7\` for \`armv7l\`, \`arm6\` for \`armv6l\`, and \`arm5\` for \`armv5tel\`.`,
      },
      {
        title: "Record the node's block number and ID",
        code: `geth attach --exec 'eth.blockNumber' ~/.ethereum/classic/geth.ipc
geth attach --exec 'admin.nodeInfo.enode' ~/.ethereum/classic/geth.ipc`,
        after: `${keepId} These commands use the default data directory. For Mordor, use \`~/.ethereum/mordor\`; if you pass \`--datadir\`, use yours. On the unit in the [Linux run guide](${DOCS_URL}getting-started/run/linux/), the \`geth\` user owns \`/var/lib/core-geth\`, so attach as \`sudo -u geth -H geth --classic attach --exec 'admin.nodeInfo.enode' /var/lib/core-geth/geth.ipc\` instead, here and in every later attach line.`,
      },
      {
        title: "Stop the node cleanly",
        after: `Press Ctrl-C once in the node's terminal and wait, or stop the systemd unit you wrote, for example \`sudo systemctl stop core-geth\`. ${cleanStop} Under systemd, \`journalctl -u core-geth\` shows that log.`,
      },
      {
        title: "Install the release",
        code: `unzip -o core-geth-linux-${releaseTag}.zip &&
  { test -e /usr/local/bin/geth-${EXPOSED_LINE} || sudo mv /usr/local/bin/geth /usr/local/bin/geth-${EXPOSED_LINE}; } &&
  sudo install -m 0755 geth /usr/local/bin/geth &&
  geth version`,
        after: `Go on only if \`geth version\` reports a \`${RECOMMENDED_LINE}\` release. ${keepBinary}`,
      },
      {
        title: "Rename the old P2P node key",
        code: "mv -n ~/.ethereum/classic/geth/nodekey ~/.ethereum/classic/geth/nodekey.old-rotated-$(date +%F)",
        after: `${rotationRequired} On the unit in the Linux run guide, run \`sudo -u geth mv -n /var/lib/core-geth/geth/nodekey /var/lib/core-geth/geth/nodekey.old-rotated-$(date +%F)\` instead.`,
      },
      staticPeersStep(),
      checkFlags,
      {
        title: "Start the node",
        code: "sudo systemctl daemon-reload && sudo systemctl start core-geth",
        after:
          "`core-geth` stands for the systemd unit you wrote, and the reload picks up any flag you changed in that unit. From a terminal, start the node the way you always do, with the flags you just checked.",
      },
      {
        title: "Confirm the move",
        code: `geth attach --exec 'admin.nodeInfo.name' ~/.ethereum/classic/geth.ipc
geth attach --exec 'admin.nodeInfo.enode' ~/.ethereum/classic/geth.ipc
geth attach --exec 'net.peerCount' ~/.ethereum/classic/geth.ipc
geth attach --exec 'eth.blockNumber' ~/.ethereum/classic/geth.ipc`,
        after: confirmNote,
      },
      otherNodesStep("geth attach", "~/.ethereum/classic/geth.ipc"),
    ],
    guide: { label: "Linux users guide", href: `${DOCS_URL}tutorials/migration/linux/` },
  },
  {
    id: "macos",
    label: "macOS",
    steps: [
      trialNode,
      {
        title: "Download the release and check it",
        code: `curl -LO ${assetBase}/core-geth-osx-arm64-${releaseTag}.zip
curl -LO ${assetBase}/core-geth-osx-arm64-${releaseTag}.zip.sha256
shasum -a 256 -c core-geth-osx-arm64-${releaseTag}.zip.sha256`,
        after: `The node can keep running for this step. \`shasum -a 256 -c\` must print \`OK\`: if it prints \`FAILED\`, delete the file and download it again rather than running it. ${verifyPointer} On an Intel Mac, put \`osx\` where the file name says \`osx-arm64\`, here and in the install step.`,
      },
      {
        title: "Record the node's block number and ID",
        code: `geth attach --exec 'eth.blockNumber' ~/Library/Ethereum/classic/geth.ipc
geth attach --exec 'admin.nodeInfo.enode' ~/Library/Ethereum/classic/geth.ipc`,
        after: `${keepId} These commands use the default data directory. For Mordor, use \`~/Library/Ethereum/mordor\`; if you pass \`--datadir\`, use yours.`,
      },
      {
        title: "Stop the node cleanly",
        after: `Press Ctrl-C once in the node's terminal and wait, or unload the launchd job. [Stop it cleanly](${DOCS_URL}getting-started/run/macos/#7-stop-it-cleanly) has the command for the run guide's agent. ${cleanStop}`,
      },
      {
        title: "Install the release",
        code: `unzip -o core-geth-osx-arm64-${releaseTag}.zip &&
  { test -e /usr/local/bin/geth-${EXPOSED_LINE} || sudo mv /usr/local/bin/geth /usr/local/bin/geth-${EXPOSED_LINE}; } &&
  sudo install -m 0755 geth /usr/local/bin/geth &&
  geth version`,
        after: `Go on only if \`geth version\` reports a \`${RECOMMENDED_LINE}\` release. ${keepBinary}`,
      },
      {
        title: "Rename the old P2P node key",
        code: "mv -n ~/Library/Ethereum/classic/geth/nodekey ~/Library/Ethereum/classic/geth/nodekey.old-rotated-$(date +%F)",
        after: rotationRequired,
      },
      staticPeersStep(),
      checkFlags,
      {
        title: "Start the node",
        after: "Start the node the way you always do, with the flags you just checked.",
      },
      {
        title: "Confirm the move",
        code: `geth attach --exec 'admin.nodeInfo.name' ~/Library/Ethereum/classic/geth.ipc
geth attach --exec 'admin.nodeInfo.enode' ~/Library/Ethereum/classic/geth.ipc
geth attach --exec 'net.peerCount' ~/Library/Ethereum/classic/geth.ipc
geth attach --exec 'eth.blockNumber' ~/Library/Ethereum/classic/geth.ipc`,
        after: confirmNote,
      },
      otherNodesStep("geth attach", "~/Library/Ethereum/classic/geth.ipc"),
    ],
    guide: { label: "macOS users guide", href: `${DOCS_URL}tutorials/migration/macos/` },
  },
  {
    id: "windows",
    label: "Windows",
    steps: [
      trialNode,
      {
        title: "Download the release and check it",
        code: `# In PowerShell, in the folder that holds your current geth.exe
Invoke-WebRequest "${assetBase}/core-geth-win64-${releaseTag}.zip" -OutFile "core-geth-win64-${releaseTag}.zip"
Invoke-WebRequest "${assetBase}/core-geth-win64-${releaseTag}.zip.sha256" -OutFile "core-geth-win64-${releaseTag}.zip.sha256"

# Compare these two lines
(Get-FileHash "core-geth-win64-${releaseTag}.zip" -Algorithm SHA256).Hash
Get-Content "core-geth-win64-${releaseTag}.zip.sha256"`,
        after: `The node can keep running for this step. ${windowsCompare} If they differ, delete the file and download it again rather than running it. ${verifyPointer}`,
      },
      {
        title: "Record the node's block number and ID",
        code: `.\\geth.exe attach --exec 'eth.blockNumber' \\\\.\\pipe\\geth.ipc
.\\geth.exe attach --exec 'admin.nodeInfo.enode' \\\\.\\pipe\\geth.ipc`,
        after: keepId,
      },
      {
        title: "Stop the node cleanly",
        after: `Press Ctrl+C once in the node's console window and wait. A window opened from the Startup folder then asks \`Terminate batch job (Y/N)?\`; type \`Y\`. Under a service wrapper, stop it with that tool. ${cleanStop}`,
      },
      {
        title: "Install the release",
        code: `Rename-Item .\\geth.exe geth-${EXPOSED_LINE}.exe
Expand-Archive "core-geth-win64-${releaseTag}.zip" -DestinationPath . -Force
.\\geth.exe version`,
        after: `Go on only if \`.\\geth.exe version\` reports a \`${RECOMMENDED_LINE}\` release. \`geth-${EXPOSED_LINE}.exe\` is the old binary, kept so you can roll back.`,
      },
      {
        title: "Rename the old P2P node key",
        code: `$key = "$env:LOCALAPPDATA\\Ethereum\\classic\\geth\\nodekey"
Rename-Item $key "nodekey.old-rotated-$(Get-Date -Format yyyy-MM-dd)"`,
        after: `${rotationRequired} The commands use the default data directory, but the node uses \`%USERPROFILE%\\AppData\\Roaming\\Ethereum\\classic\` instead if an older \`AppData\\Roaming\\Ethereum\` folder exists and is not empty. For Mordor, use \`mordor\` in place of \`classic\`; if you pass \`--datadir\`, use yours.`,
      },
      staticPeersStep(
        " Save the file as UTF-8 with no byte order mark. A byte order mark, or UTF-16, stops the start with `invalid TOML syntax`.",
      ),
      checkFlags,
      {
        title: "Start the node",
        after: "Start the node the way you always do, with the flags you just checked.",
      },
      {
        title: "Confirm the move",
        code: `.\\geth.exe attach --exec 'admin.nodeInfo.name' \\\\.\\pipe\\geth.ipc
.\\geth.exe attach --exec 'admin.nodeInfo.enode' \\\\.\\pipe\\geth.ipc
.\\geth.exe attach --exec 'net.peerCount' \\\\.\\pipe\\geth.ipc
.\\geth.exe attach --exec 'eth.blockNumber' \\\\.\\pipe\\geth.ipc`,
        after: confirmNote,
      },
      otherNodesStep(".\\geth.exe attach", "\\\\.\\pipe\\geth.ipc"),
    ],
    guide: { label: "Windows users guide", href: `${DOCS_URL}tutorials/migration/windows/` },
  },
  {
    id: "containers",
    label: "Containers",
    steps: [
      trialNode,
      {
        title: "Pull the release",
        code: `docker pull ghcr.io/${REPO.slug}:latest
gh attestation verify oci://ghcr.io/${REPO.slug}:latest --repo ${REPO.slug}`,
        after: `The node can keep running for this step. ${attestationMust("docker-publish.yml", "run the image")} [Verify what you downloaded](#verify) checks an image file from the release. A loaded image file carries its release tag and no \`latest\` tag, so put that tag in place of \`latest\` in the steps below, or Docker pulls from the registry instead.`,
      },
      {
        title: "Record the node's block number and ID",
        code: `docker exec core-geth geth attach --exec 'eth.blockNumber' /root/.ethereum/classic/geth.ipc
docker exec core-geth geth attach --exec 'admin.nodeInfo.enode' /root/.ethereum/classic/geth.ipc`,
        after: `${keepId} These commands use a container named \`core-geth\` with its data at \`/root\`, so put your own name in its place. For Mordor, use \`.ethereum/mordor\` in the paths.`,
      },
      {
        title: "Stop the node cleanly",
        code: `docker stop -t 300 core-geth
docker logs --tail 50 core-geth 2>&1 | grep 'Blockchain stopped'`,
        after: `Continue only once the second command prints \`Blockchain stopped\`. Use \`-t 300\`: a plain \`docker stop\` kills the node if it has not stopped within 10 seconds. A killed node that was importing blocks moves its head back on its next start and imports them again ([After an unclean stop](${DOCS_URL}operate/maintenance/#after-an-unclean-stop)).`,
      },
      {
        title: "Rename the old P2P node key",
        code: `docker run --rm --volumes-from core-geth --entrypoint sh ghcr.io/${REPO.slug}:latest \\
  -c "mv -n /root/.ethereum/classic/geth/nodekey /root/.ethereum/classic/geth/nodekey.old-rotated-$(date +%F)"`,
        after: rotationRequired,
      },
      staticPeersStep(
        ' To give the new container the file, add `-v <path>/config.toml:/config.toml:ro` to the `docker run` under "Replace the container", and `--config /config.toml` after the image name.',
      ),
      checkFlags,
      {
        title: "Replace the container",
        code: `docker rename core-geth core-geth-${EXPOSED_LINE}
docker update --restart no core-geth-${EXPOSED_LINE}
docker run -d --name core-geth \\
  --restart unless-stopped --stop-timeout 300 \\
  --volumes-from core-geth-${EXPOSED_LINE} \\
  -p 30303:30303 -p 30303:30303/udp -p 127.0.0.1:8545:8545 \\
  ghcr.io/${REPO.slug}:latest \\
  --classic --http --http.addr 0.0.0.0 --http.port 8545`,
        after: `Put your own ports and flags in the last lines of \`docker run\`: \`docker inspect core-geth-${EXPOSED_LINE}\` shows what the old container used. For Mordor, use \`--mordor\` in place of \`--classic\`. The old container stays, stopped, and is what you roll back to.`,
      },
      {
        title: "Confirm the move",
        code: `docker exec core-geth geth version
docker exec core-geth geth attach --exec 'admin.nodeInfo.enode' /root/.ethereum/classic/geth.ipc
docker exec core-geth geth attach --exec 'net.peerCount' /root/.ethereum/classic/geth.ipc
docker exec core-geth geth attach --exec 'eth.blockNumber' /root/.ethereum/classic/geth.ipc`,
        after: confirmNote,
      },
      otherNodesStep("docker exec core-geth geth attach", "/root/.ethereum/classic/geth.ipc"),
      {
        title: "If you need to roll back",
        code: `docker stop -t 300 core-geth &&
  docker rm core-geth &&
  docker rename core-geth-${EXPOSED_LINE} core-geth &&
  docker update --restart unless-stopped core-geth &&
  docker start core-geth`,
        after:
          "Put the old container's restart policy in place of `unless-stopped`. Keep the new key: rolling back does not make the old key safe.",
      },
    ],
    guide: { label: "Docker users guide", href: `${DOCS_URL}tutorials/migration/docker/` },
  },
  {
    id: "source",
    label: "Source",
    steps: [
      trialNode,
      {
        title: "Build the release",
        code: `git clone --branch ${releaseTag} --single-branch https://github.com/${REPO.slug}.git core-geth-${releaseTag} &&
  cd core-geth-${releaseTag} &&
  make geth &&
  ./build/bin/geth version`,
        after: `The node can keep running for this step. Go on only if the last line reports a \`${RECOMMENDED_LINE}\` release. [Build from source](${DOCS_URL}developers/build-from-source/) lists what a build needs. On Windows, run the commands one at a time, with \`go run build/ci.go install ./cmd/geth\` in place of \`make geth\`, then follow the Windows tab, copying \`build\\bin\\geth.exe\` into the node's folder in place of its \`Expand-Archive\` line.`,
      },
      {
        title: "Record the node's block number and ID",
        code: `geth attach --exec 'eth.blockNumber' ~/.ethereum/classic/geth.ipc
geth attach --exec 'admin.nodeInfo.enode' ~/.ethereum/classic/geth.ipc`,
        after: `${keepId} The commands in this tab use the default data directory on Linux. On macOS, put \`~/Library/Ethereum\` where they say \`~/.ethereum\`. For Mordor, use \`mordor\` in place of \`classic\`; if you pass \`--datadir\`, use yours. The Linux tab has the forms for the unit in the Linux run guide.`,
      },
      {
        title: "Stop the node cleanly",
        after: `Press Ctrl-C once in the node's terminal and wait, or stop the service you run the node under. ${cleanStop}`,
      },
      {
        title: "Install the build",
        code: `ls build/bin/geth &&
  { test -e /usr/local/bin/geth-${EXPOSED_LINE} || sudo mv /usr/local/bin/geth /usr/local/bin/geth-${EXPOSED_LINE}; } &&
  sudo install -m 0755 build/bin/geth /usr/local/bin/geth &&
  geth version`,
        after: `Run this in the folder the build step left you in: the first line stops the block anywhere else. Go on only if \`geth version\` reports a \`${RECOMMENDED_LINE}\` release. ${keepBinary}`,
      },
      {
        title: "Rename the old P2P node key",
        code: "mv -n ~/.ethereum/classic/geth/nodekey ~/.ethereum/classic/geth/nodekey.old-rotated-$(date +%F)",
        after: rotationRequired,
      },
      staticPeersStep(),
      checkFlags,
      {
        title: "Start the node",
        after: "Start the node the way you always do, with the flags you just checked.",
      },
      {
        title: "Confirm the move",
        code: `geth attach --exec 'admin.nodeInfo.name' ~/.ethereum/classic/geth.ipc
geth attach --exec 'admin.nodeInfo.enode' ~/.ethereum/classic/geth.ipc
geth attach --exec 'net.peerCount' ~/.ethereum/classic/geth.ipc
geth attach --exec 'eth.blockNumber' ~/.ethereum/classic/geth.ipc`,
        after: confirmNote,
      },
      otherNodesStep("geth attach", "~/.ethereum/classic/geth.ipc"),
    ],
    guide: { label: "Migration guide", href: DOCS.migration.href },
  },
];

// The Quick start in `ethereumclassic/discv4-dns-lists`, whose three trees
// `params/bootnodes_classic.go` in `ethereumclassic/core-geth` builds into the recommended line.
const discoveryFlag = `geth --classic --discovery.dns "enrtree://APDLRZ2T7ERXPWXX4D5USB32NIFYHXMFVZQ3DZALK6JJJ5L4VSYIQ@all.classic.ethereumclassic.net,enrtree://APDLRZ2T7ERXPWXX4D5USB32NIFYHXMFVZQ3DZALK6JJJ5L4VSYIQ@all.classic.ethclassic.net,enrtree://APDLRZ2T7ERXPWXX4D5USB32NIFYHXMFVZQ3DZALK6JJJ5L4VSYIQ@all.classic.ethereumclassic.network"`;

const moveLede = `${MOVE_RECOMMENDATION} ${UPGRADE_COST} Follow the steps for your platform below rather than the install steps at the top of this page, which start a node before its P2P node key changes. These steps keep your old binary or container so you can roll back, and rotate the key before the node starts again. The rotation is required: one of the flaws in the \`${EXPOSED_LINE}\` line leaks bits of the P2P node key across repeated handshakes, and no fix can take back what already leaked.`;

const moveNote = `The [migration guide](${DOCS.migration.href}) also says what else names this node, and how to roll back. A \`${EXPOSED_LINE}\` binary refuses the \`--mess\` flag, so take it out of the start command before you roll back.`;

const flagIntro = `A node that cannot move yet should read the three peer discovery lists [\`ethereumclassic/discv4-dns-lists\`](https://github.com/ethereumclassic/discv4-dns-lists) publishes for its network, the ones the \`${RECOMMENDED_LINE}\` line reads by default. After a clean stop, add \`--discovery.dns\` with those three lists to the command or unit you already start the node with. \`ethereumclassic/discv4-dns-lists\` records that the lists a \`${EXPOSED_LINE}\` release reads by default stop being updated when the ETC Cooperative dissolves. The flag is a small step, and the node stays vulnerable: the flag closes none of the flaws the audits found in the \`${EXPOSED_LINE}\` line.`;

const flagNote = `For Mordor, use \`--mordor\` and swap \`all.classic.\` for \`all.mordor.\` in all three lists. On Windows, run \`.\\geth.exe\` in place of \`geth\`. In a container, stop the container with \`docker stop -t 300\` and pass the same flags after the image name. Under systemd, run \`sudo systemctl daemon-reload\` after you edit the unit. The flag replaces the lists built into the release, and the node dials the nodes in those lists directly, so it does not need \`--bootnodes\` as well.`;

// What `gh attestation verify` prints, in a terminal, less the policy it enforced, which a reader
// does not act on. The archives and the image files are built by different workflows, and the
// attestation names the one that ran.
const attestationOutput = (file: string, workflow: string) =>
  `# Loaded digest sha256:... for file://${file}
# Loaded 1 attestation from GitHub API
# ✓ Verification succeeded!
#
# - Attestation #1
#   - Build repo:..... ${REPO.slug}
#   - Build workflow:. .github/workflows/${workflow}@refs/tags/${releaseTag}`;

const installationVerify = {
  label: "Verify where the archive came from",
  href: `${DOCS.installation.href}#verify-where-the-archive-came-from`,
};

// One panel per platform, each checking the file its install tab or release list gives a
// reader, in the installation guide's commands. A build from source has no published file to
// check, so its panel checks the commit instead, with the command the documentation's FAQ gives.
// Expected output sits in comments where the platform's shell allows them, and in the note under
// the block on macOS and for containers, which readers often run from a Mac.
const VERIFY_PANELS: readonly PlatformPanel[] = [
  {
    id: "linux",
    label: "Linux",
    steps: [
      {
        title: "Check an archive",
        code: `# 1. Check that the archive arrived intact
sha256sum -c core-geth-linux-${releaseTag}.zip.sha256
# core-geth-linux-${releaseTag}.zip: OK

# 2. Check where the archive came from
gh attestation verify core-geth-linux-${releaseTag}.zip --repo ${REPO.slug}
${attestationOutput(`core-geth-linux-${releaseTag}.zip`, "release-packages.yml")}`,
        after: `\`sha256sum -c\` must print \`OK\`. If it prints \`FAILED\`, delete the file and download it again rather than running it. ${attestationMust("release-packages.yml")} For another archive, put its name in place of \`core-geth-linux-${releaseTag}.zip\`, such as \`core-geth-arm64-${releaseTag}.zip\`.`,
      },
    ],
    guide: installationVerify,
  },
  {
    id: "macos",
    label: "macOS",
    steps: [
      {
        title: "Check an archive",
        code: `shasum -a 256 -c core-geth-osx-arm64-${releaseTag}.zip.sha256
gh attestation verify core-geth-osx-arm64-${releaseTag}.zip --repo ${REPO.slug}`,
        after: `\`shasum -a 256 -c\` must print \`OK\`. If it prints \`FAILED\`, delete the file and download it again rather than running it. ${attestationMust("release-packages.yml")} On an Intel Mac, use \`core-geth-osx-${releaseTag}.zip\`.`,
      },
    ],
    guide: installationVerify,
  },
  {
    id: "windows",
    label: "Windows",
    steps: [
      {
        title: "Check an archive",
        code: `# 1. Check that the archive arrived intact: compare these two lines, in PowerShell
(Get-FileHash "core-geth-win64-${releaseTag}.zip" -Algorithm SHA256).Hash
Get-Content "core-geth-win64-${releaseTag}.zip.sha256"

# 2. Check where the archive came from
gh attestation verify core-geth-win64-${releaseTag}.zip --repo ${REPO.slug}
${attestationOutput(`core-geth-win64-${releaseTag}.zip`, "release-packages.yml")}`,
        after: `${windowsCompare} If they differ, delete the file and download it again rather than running it. ${attestationMust("release-packages.yml")}`,
      },
    ],
    guide: installationVerify,
  },
  {
    id: "containers",
    label: "Containers",
    steps: [
      {
        title: "Check an image file",
        code: `curl -LO ${assetBase}/core-geth-docker-amd64-${releaseTag}.tar.gz
curl -LO ${assetBase}/core-geth-docker-amd64-${releaseTag}.tar.gz.sha256
sha256sum -c core-geth-docker-amd64-${releaseTag}.tar.gz.sha256
gh attestation verify core-geth-docker-amd64-${releaseTag}.tar.gz --repo ${REPO.slug}`,
        after: `On an Arm64 host, put \`docker-arm64\` where the file name says \`docker-amd64\`. \`sha256sum -c\` must print \`OK\`: if it prints \`FAILED\`, delete the file and download it again rather than loading it. ${attestationMust("docker-publish.yml", "load the file")}`,
      },
      {
        title: "Load the image",
        code: `docker load -i core-geth-docker-amd64-${releaseTag}.tar.gz`,
        after: `The loaded image keeps its published name, with \`${releaseTag}\` as its tag and no \`latest\` tag. Use that name in place of \`latest\` in a \`docker run\` command, because a command that names \`latest\` makes Docker pull from the registry.`,
      },
    ],
    guide: {
      label: "Load the image from the release",
      href: `${DOCS.installation.href}#load-the-image-from-the-release`,
    },
  },
  {
    id: "source",
    label: "Source",
    steps: [
      {
        title: "Check the commit you built",
        code: `git rev-parse HEAD
go version -m ./build/bin/geth | grep vcs.revision`,
        after:
          "Run these in the clone: the first line is the commit you checked out and the second is the commit the binary was built from. Both lines must name the same commit. On Windows, run `go version -m .\\build\\bin\\geth.exe` and read its `vcs.revision` line.",
      },
    ],
    guide: {
      label: "How do I verify a download?",
      href: `${DOCS_URL}about/faq/#how-do-i-verify-a-download`,
    },
  },
];
---

<BaseLayout
  title="Download Core-Geth for Ethereum Classic: Linux, macOS, Windows"
  crumb="Downloads"
  description="Download Core-Geth for Linux, macOS, Windows, Arm or Docker, or build from source. Every release carries a checksum and a build attestation you can verify."
  path="/downloads/"
>
  <PageHero label="Core-Geth downloads" title="Get the Core-Geth client." em="Core-Geth">
    <p class="lede">
      Download a release for Linux, macOS or Windows, run it as a container, or build it from
      source. Every archive and image is published with a checksum and a build attestation, so you
      can confirm what you downloaded before you run it.
    </p>
    <div class="downloads__actions">
      <a class="button button--primary" href={REPO.latestUrl}>
        The latest release
      </a>
      <a class="button" href={DOCS.installation.href}>
        Installation guide
      </a>
    </div>
    {downloads && (
      <p class="downloads__meta">
        {`Latest release ${downloads.tag}, published ${formatAsOf(downloads.published)}. `}
        <a href={downloads.notes}>Release notes</a>
        {" · "}
        <a href={REPO.releasesUrl}>All releases</a>
      </p>
    )}
  </PageHero>

  <section class="band band--surface" id="install" aria-labelledby="install-title">
    <div class="container downloads__install">
      <SectionHead
        id="install-title"
        label="Install Core-Geth"
        title="How to download, install, and run the Core-Geth client"
        em="download, install, and run"
      >
        <p class="lede">
          Each block takes the build most machines need: the x86-64 archive on Linux, Apple Silicon
          on macOS, the published image for containers. Check an archive against its checksum and
          its build attestation before you run it: <a href="#verify">both commands</a> are at the
          foot of this page.
        </p>
        <p class="lede">
          {`Every download on this page is the latest ${RECOMMENDED_LINE} release. If you are replacing a `}
          <InlineCode text={EXPOSED_LINE} />
          {` node, that node needs a new P2P key before it starts again: `}
          <a href={`#${UPGRADE_ANCHOR}`}>{`moving a ${EXPOSED_LINE} node`}</a>
          {` has the commands.`}
        </p>
      </SectionHead>
      <PlatformTabs legend="Choose your platform" panels={PANELS}>
        <p class="panel__note" slot="before-linux">
          The x86-64 and Arm64 archives need glibc 2.17 or newer, which is RHEL 7, CentOS 7 and
          anything more recent; the 32-bit Arm archives need glibc 2.28 or newer. The{" "}
          <a href={`${DOCS.releaseReport.href}#archives`}>release report</a> lists every archive and
          its platform.
        </p>
        <Fragment slot="before-source">
          <p class="panel__note">
            Building needs Go 1.26 or later and a C compiler. A binary built from <code>main</code>{" "}
            prints <code>unstable</code> as its release stage until a release is prepared. To build
            with the exact Go toolchain the releases use, run{" "}
            <code>go run build/ci.go install -dlgo</code> in place of <code>make geth</code>.
          </p>
          <a class="source-repo" href={REPO.url}>
            github.com/{REPO.slug.split("/")[0]}/<wbr />
            {REPO.slug.split("/")[1]}
          </a>
        </Fragment>
        <ReleaseFiles slot="after-linux" group={groupFor("linux")} />
        <ReleaseFiles slot="after-macos" group={groupFor("macos")} />
        <ReleaseFiles slot="after-windows" group={groupFor("windows")} />
        <ReleaseFiles slot="after-containers" group={groupFor("containers")} />
      </PlatformTabs>

      <p class="downloads__note">
        An <code>alltools</code> archive is the same client with the rest of the tools beside it:{" "}
        <code>abigen</code>, <code>clef</code>, <code>evm</code>, <code>rlpdump</code> and the
        others. To run a node, take the plain archive.
      </p>
    </div>
  </section>

  <section class="band" id={UPGRADE_ANCHOR} aria-labelledby="upgrade-title">
    <div class="container downloads__install">
      <SectionHead
        id="upgrade-title"
        label={`Moving a Core-Geth ${EXPOSED_LINE} node`}
        title={`Move a ${EXPOSED_LINE} node to the ${RECOMMENDED_LINE} line`}
        em={`the ${RECOMMENDED_LINE} line`}
        size="medium"
      >
        <p class="lede">
          <InlineCode text={moveLede} />
        </p>
      </SectionHead>
      <PlatformTabs
        legend="Choose your platform for moving a node"
        panels={MOVE_PANELS}
        prefix="move-"
      />
      <div class="downloads__group">
        <p>
          <InlineCode text={moveNote} />
        </p>
        <h3 id={DISCOVERY_FLAG_ANCHOR}>{`If a ${EXPOSED_LINE} node cannot move yet`}</h3>
        <p>
          <InlineCode text={flagIntro} />
        </p>
        <div class="shell-wrap">
          <pre class="shell"><code>{discoveryFlag}</code></pre>
        </div>
        <p class="panel__note">
          <InlineCode text={flagNote} />
        </p>
      </div>
    </div>
  </section>

  <section class="band band--surface" id="verify" aria-labelledby="verify-title">
    <div class="container downloads__install">
      <SectionHead
        id="verify-title"
        label="Verify a Core-Geth download"
        title="Verify what you downloaded"
        em="Verify"
        size="medium"
      >
        <p class="lede">
          The checksum says the file arrived intact. The attestation says which workflow built it,
          from which commit.
        </p>
      </SectionHead>
      <PlatformTabs
        legend="Choose your platform for checking a download"
        panels={VERIFY_PANELS}
        prefix="verify-"
      />
      <div class="downloads__group">
        <h3>What every release carries</h3>
        <ul class="plain" role="list">
          <li>
            <strong>A checksum beside every file.</strong> A <code>.sha256</code> is published with
            each archive and each image tarball.
          </li>
          <li>
            <strong>A build attestation on every archive and image.</strong> It is minted against a
            short-lived certificate issued to the workflow run itself, and records which workflow,
            at which commit, produced the file, so each one traces to the run that built it rather
            than resting on anyone's word.
          </li>
          <li>
            <strong>Provenance for the container images.</strong> Recorded for the published image
            index and for each image tarball.
          </li>
        </ul>
        <p>
          On a first run Windows names the publisher as unknown, and macOS blocks a downloaded
          binary until it is allowed. The <a href={DOCS.installation.href}>installation guide</a>{" "}
          says how to check an archive and proceed.
        </p>
        <a class="more" href={`${DOCS_URL}audits/2026-09-release-pipeline/`}>
          <ArrowText text="How the release artifacts are built and checked" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<CopyButtons />

<style>
  .downloads__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .downloads__meta,
  .downloads__note {
