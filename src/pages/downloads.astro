---
import ArrowText from "@/components/ArrowText.astro";
import CopyButtons from "@/components/CopyButtons.astro";
import InlineCode from "@/components/InlineCode.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PlatformTabs from "@/components/PlatformTabs.astro";
import ReleaseFiles from "@/components/ReleaseFiles.astro";
import SectionHead from "@/components/SectionHead.astro";
import { formatAsOf } from "@/data/repository";
import {
  DOCS,
  DISCOVERY_FLAG_ANCHOR,
  DISCOVERY_ROUTE,
  EXPOSED_LINE,
  INSTALL_ANCHOR,
  RECOMMENDED_LINE,
  REPO,
  UPGRADE_ANCHOR,
} from "@/data/site";
import {
  downloads,
  groupFor,
  linuxArchiveNote,
  MOVE_PANELS,
  MOVE_SOURCE_PANELS,
  moveLede,
  moveNote,
  moveSourceIntro,
  PANELS,
  SOURCE_PANELS,
  sourceIntro,
  VERIFY_PANELS,
  VERIFY_SOURCE_PANELS,
} from "@/data/steps";
---

<BaseLayout
  title="Download Core-Geth for Ethereum Classic: Linux, macOS, Windows"
  crumb="Downloads"
  description="Download Core-Geth for Linux, macOS, Windows, Arm or Docker, or build from source. Every release carries a checksum and a build attestation you can verify."
  path="/downloads/"
>
  <PageHero label="Core-Geth downloads" title="Get the Core-Geth client." em="Core-Geth">
    <p class="lede">
      Download a release for Linux, macOS or Windows, run it as a container, or build the client
      from source. Every archive and image is published with a checksum and a build attestation, so
      you can confirm what you downloaded before you run it.
    </p>
    <div class="downloads__actions">
      <a class="button button--primary" href={REPO.latestUrl}>
        The latest release
      </a>
      <a class="button" href={DOCS.installation.href}>
        Installation guide
      </a>
    </div>
    {downloads && (
      <p class="downloads__meta">
        {`Latest release ${downloads.tag}, published ${formatAsOf(downloads.published)}. `}
        <a href={downloads.notes}>Release notes</a>
        {" · "}
        <a href={REPO.releasesUrl}>All releases</a>
      </p>
    )}
  </PageHero>

  <section class="band band--surface" id={INSTALL_ANCHOR} aria-labelledby="install-title">
    <div class="container downloads__install">
      <SectionHead
        id="install-title"
        label="Install Core-Geth"
        title="How to download, install, and run the Core-Geth client"
        em="download, install, and run"
      >
        <p class="lede">
          Each block takes the build most machines need: the x86-64 archive on Linux, Apple Silicon
          on macOS, the published image for containers. Check an archive against its checksum and
          its build attestation before you run it: <a href="#verify">both commands</a> are at the
          foot of this page.
        </p>
        <p class="lede">
          {`Every archive and image on this page is from the latest ${RECOMMENDED_LINE} release. If you are replacing a `}
          <InlineCode text={EXPOSED_LINE} />
          {` node, that node needs a new P2P key before it starts again: `}
          <a href={`#${UPGRADE_ANCHOR}`}>{`moving a ${EXPOSED_LINE} node`}</a>
          {` has the commands.`}
        </p>
      </SectionHead>
      <PlatformTabs legend="Choose your platform" panels={PANELS}>
        <p class="panel__note" slot="before-linux">
          <InlineCode text={linuxArchiveNote} />
        </p>
        <Fragment slot="before-source">
          <a class="source-repo" href={REPO.url}>
            github.com/{REPO.slug.split("/")[0]}/<wbr />
            {REPO.slug.split("/")[1]}
          </a>
          <p class="panel__note">
            <InlineCode text={sourceIntro} />
          </p>
          <PlatformTabs
            legend="Choose your platform for building from source"
            panels={SOURCE_PANELS}
            prefix="source-"
            nested
          />
        </Fragment>
        <ReleaseFiles slot="after-linux" group={groupFor("linux")} />
        <ReleaseFiles slot="after-macos" group={groupFor("macos")} />
        <ReleaseFiles slot="after-windows" group={groupFor("windows")} />
        <ReleaseFiles slot="after-containers" group={groupFor("containers")} />
      </PlatformTabs>

      <p class="downloads__note">
        An <code>alltools</code> archive is the same client with the rest of the tools beside it:{" "}
        <code>abigen</code>, <code>clef</code>, <code>evm</code>, <code>rlpdump</code> and the
        others. To run a node, take the plain archive.
      </p>
    </div>
  </section>

  <section class="band" id={UPGRADE_ANCHOR} aria-labelledby="upgrade-title">
    <div class="container downloads__install">
      <SectionHead
        id="upgrade-title"
        label={`Moving a Core-Geth ${EXPOSED_LINE} node`}
        title={`Move a ${EXPOSED_LINE} node to the ${RECOMMENDED_LINE} line`}
        em={`the ${RECOMMENDED_LINE} line`}
        size="medium"
      >
        <p class="lede">
          <InlineCode text={moveLede} />
        </p>
      </SectionHead>
      <PlatformTabs
        legend="Choose your platform for moving a node"
        panels={MOVE_PANELS}
        prefix="move-"
      >
        <Fragment slot="before-source">
          <p class="panel__note">
            <InlineCode text={moveSourceIntro} />
          </p>
          <PlatformTabs
            legend="Choose your platform for building from source and moving a node"
            panels={MOVE_SOURCE_PANELS}
            prefix="move-source-"
            nested
          />
        </Fragment>
      </PlatformTabs>
      <div class="downloads__group">
        <p>
          <InlineCode text={moveNote} />
        </p>
        <h3 id={DISCOVERY_FLAG_ANCHOR}>{`If a ${EXPOSED_LINE} node cannot move yet`}</h3>
        <p>
          <InlineCode text={DISCOVERY_ROUTE} />
        </p>
      </div>
    </div>
  </section>

  <section class="band band--surface" id="verify" aria-labelledby="verify-title">
    <div class="container downloads__install">
      <SectionHead
        id="verify-title"
        label="Verify a Core-Geth download"
        title="Verify what you downloaded"
        em="Verify"
        size="medium"
      >
        <p class="lede">
          The checksum says the file arrived intact. The attestation says which workflow built it,
          from which commit.
        </p>
      </SectionHead>
      <PlatformTabs
        legend="Choose your platform for checking a download"
        panels={VERIFY_PANELS}
        prefix="verify-"
      >
        <PlatformTabs
          slot="before-source"
          legend="Choose your platform for checking a build from source"
          panels={VERIFY_SOURCE_PANELS}
          prefix="verify-source-"
          nested
        />
      </PlatformTabs>
      <div class="downloads__group">
        <h3>What every release carries</h3>
        <ul class="plain" role="list">
          <li>
            <strong>A checksum beside every file.</strong> A <code>.sha256</code> is published with
            each archive and each image tarball.
          </li>
          <li>
            <strong>A build attestation on every archive and image.</strong> It is minted against a
            short-lived certificate issued to the workflow run itself, and records which workflow,
            at which commit, produced the file, so each one traces to the run that built it rather
            than resting on anyone's word.
          </li>
          <li>
            <strong>Provenance for the container images.</strong> Recorded for the published image
            index and for each image tarball.
          </li>
        </ul>
        <p>
          On a first run Windows names the publisher as unknown, and macOS blocks a downloaded
          binary until it is allowed. The <a href={DOCS.installation.href}>installation guide</a>{" "}
          says how to check an archive and proceed.
        </p>
        <a class="more" href="/security/2026-09-core-geth-v1.12-release-pipeline/">
          <ArrowText text="How the release artifacts are built and checked" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<CopyButtons />

<style>
  .downloads__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .downloads__meta,
  .downloads__note {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .downloads__note {
    padding-top: 2rem;
  }

  /* The band's opening head, then the tabs, with the band's own rhythm between them. */
  .downloads__install {
    display: grid;
    gap: 2.5rem;
  }

  .downloads__group {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .downloads__group h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .downloads__group h3 {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .downloads__group p:not(.panel__note) {
    margin: 0;
    color: var(--text);
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* The source the client is built from, named once and set large: the documentation's
     code face for a repository name, in the page's green. It may break after the slash
     and nowhere else, so it never widens the panel. */
  .source-repo {
    max-width: 100%;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: clamp(1.1rem, 3.2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .source-repo:hover {
    text-decoration: underline;
  }

  .plain {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text);
    line-height: 1.6;
  }

  .plain strong {
    color: var(--ink);
  }

  .more {
    font-weight: 650;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
