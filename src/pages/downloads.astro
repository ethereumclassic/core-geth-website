      <SectionHead
        id="upgrade-title"
        label={`Moving a Core-Geth ${EXPOSED_LINE} node`}
        title={`Move a ${EXPOSED_LINE} node to the ${RECOMMENDED_LINE} line`}
        em={`the ${RECOMMENDED_LINE} line`}
        size="medium"
      >
        <p class="lede">
          <InlineCode text={moveLede} />
        </p>
      </SectionHead>
      <PlatformTabs
