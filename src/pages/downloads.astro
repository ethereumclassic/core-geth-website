        </p>
        <h3 id={DISCOVERY_FLAG_ANCHOR}>{`If a ${EXPOSED_LINE} node cannot move yet`}</h3>
        <p>
          <InlineCode text={flagIntro} />
        </p>
        <div class="shell-wrap">
          <pre class="shell"><code>{discoveryFlag}</code></pre>
        </div>
