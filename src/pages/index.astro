---
import BaseLayout from "@/layouts/BaseLayout.astro";
import About from "@/components/sections/About.astro";
import Guides from "@/components/sections/Guides.astro";
import Hero from "@/components/sections/Hero.astro";
import Operators from "@/components/sections/Operators.astro";
import Repository from "@/components/sections/Repository.astro";
import Records from "@/components/sections/Records.astro";
import Support from "@/components/sections/Support.astro";
import { getRepository } from "@/data/repository";

// A landing page: what Core-Geth is, where its releases come from, what went wrong and
// what fixed it, what an operator does first, which guide to start with, and how it is
// funded. Each section is a few lines and a link to the page that says the rest.
// The bands alternate white and grid, starting white under the hero.
const facts = await getRepository();
---

<BaseLayout>
  <Hero />
  <About />
  <Repository facts={facts} />
  <Records
    tone="surface"
    brief
    cta={{ label: "What the network is running, and every audit", href: "/security/" }}
  />
  <Operators />
  <Guides />
  <Support />
</BaseLayout>
